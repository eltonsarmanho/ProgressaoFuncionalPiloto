# Copie para .env e preencha. Nunca versione o .env.

# PostgreSQL
POSTGRES_USER=progressao
POSTGRES_PASSWORD=
POSTGRES_DB=progressao
# Use o mesmo usuário, senha e banco acima; o host é o serviço "postgres".
DATABASE_URL=postgresql+psycopg://progressao:<POSTGRES_PASSWORD>@postgres:5432/progressao

# Administrador criado na primeira inicialização (senha com no mínimo 10 caracteres)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# true exige HTTPS para o cookie de sessão; use false apenas sem HTTPS (ex.: teste local)
COOKIE_SECURE=true

# Porta HTTP publicada pelo nginx
HTTP_PORT=80

# MariTalk (opcional nesta versão)
MARITALK_API_KEY=
MARITALK_API_BASE=
MARITALK_MODEL=
